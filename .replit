modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["glibcLocales", "imagemagick"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
run = ["node", "./dist/index.cjs"]
build = ["npm", "run", "build"]
publicDir = "dist/public"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Voice Agent Wizard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "stripe-unit-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "lint"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "format"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-all"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-all-parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "fix-all"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "schema-check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-inline-migrations"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "api-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx tests/api.test.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsc --noEmit"

[[workflows.workflow]]
name = "Voice Agent Wizard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python wizard/app.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "stripe-unit-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx vitest run --reporter=verbose"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "lint"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx eslint ."

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "format"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx prettier --check ."

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "check-all"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx eslint . && npx tsc --noEmit && npx prettier --check ."

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "check-all-parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx concurrently --raw \"npx eslint .\" \"npx tsc --noEmit\" \"npx prettier --check .\""

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "fix-all"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx eslint . --fix && npx prettier --write ."

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "schema-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/check-schema.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "check-inline-migrations"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/check-inline-migrations.sh"

[workflows.workflow.metadata]
isValidation = true

[agent]
integrations = ["javascript_database:1.0.0", "javascript_object_storage:2.0.0", "javascript_websocket:1.0.0", "javascript_openai_ai_integrations:2.0.0"]

